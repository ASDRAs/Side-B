# Last.fm
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Gemini (remove after the local tag classifier replaces Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# YouTube Data API v3 (server-side search only)
YOUTUBE_API_KEY=
# Shared team secret for hosted /recommend and /exports/youtube/matches requests.
# YOUTUBE_EXPORT_TOKEN remains a supported legacy alias during migration.
SIDE_B_ACCESS_TOKEN=
RECOMMEND_REQUESTS_PER_MINUTE=6
YOUTUBE_EXPORT_REQUESTS_PER_MINUTE=6
YOUTUBE_SEARCH_DAILY_BUDGET=80
YOUTUBE_MATCH_THRESHOLD=0.85
YOUTUBE_SEARCH_MAX_RESULTS=5
YOUTUBE_SEARCH_CONCURRENCY=3

# Backend timeouts (seconds)
HTTP_TIMEOUT_SECONDS=6

# Keep authentication enabled by default. Set this to true only in a local .env
# when testing browser clients without a team token. Never enable it publicly.
ALLOW_UNAUTHENTICATED_RECOMMEND=false
CORS_ALLOWED_ORIGINS=chrome-extension://hfcclomfoickmehgmdgjdjmiiekaciam,http://127.0.0.1:3000,http://localhost:3000

# Docker Compose host port
BACKEND_PORT=8000
