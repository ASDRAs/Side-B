# Last.fm
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Gemini (remove after the local tag classifier replaces Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# YouTube Data API v3 (server-side search only)
YOUTUBE_API_KEY=
# Shared team secret for hosted /recommend and /exports/youtube/matches requests.
# YOUTUBE_EXPORT_TOKEN remains a supported legacy alias during migration.
SIDE_B_ACCESS_TOKEN=
SIDE_B_AUTH_MODE=legacy
FIREBASE_PROJECT_ID=
FIREBASE_ALLOWED_UIDS=
FIREBASE_ALLOWED_EMAILS=
FIREBASE_VERIFY_TIMEOUT_SECONDS=8
FIREBASE_HTTP_TIMEOUT_SECONDS=5
FIREBASE_VERIFY_CONCURRENCY=8

# Approval source. "env" keeps FIREBASE_ALLOWED_* / the shared token above.
# "firestore" stores approvals in access_users/{uid}; it requires
# SIDE_B_AUTH_MODE=firebase and SIDE_B_ADMIN_UIDS or the server refuses to start,
# and it never falls back to the allowlists or the shared token.
# See docs/auth-approval-operations.md.
SIDE_B_ACCESS_STORE=env
# Server administrator Firebase UIDs (comma separated). Look them up in Firebase
# Authentication; never guess them.
SIDE_B_ADMIN_UIDS=
# Defaults to FIREBASE_PROJECT_ID. Credentials come from ADC, never a key file.
SIDE_B_FIRESTORE_PROJECT_ID=
SIDE_B_FIRESTORE_DATABASE=(default)
SIDE_B_ACCESS_STORE_TIMEOUT_SECONDS=8
SIDE_B_ACCESS_STORE_CONCURRENCY=8
# Global cap on new access requests per UTC day (Firestore counter).
ACCESS_REQUEST_DAILY_LIMIT=50
# Instance-local per-user / aggregate limits per minute.
ACCESS_STATUS_REQUESTS_PER_MINUTE=20
ACCESS_STATUS_AGGREGATE_REQUESTS_PER_MINUTE=300
ACCESS_LOOKUP_REQUESTS_PER_MINUTE=60
ACCESS_LOOKUP_AGGREGATE_REQUESTS_PER_MINUTE=600
ACCESS_REQUEST_REQUESTS_PER_MINUTE=3
ACCESS_REQUEST_AGGREGATE_REQUESTS_PER_MINUTE=30
ADMIN_READ_REQUESTS_PER_MINUTE=30
ADMIN_READ_AGGREGATE_REQUESTS_PER_MINUTE=120
ADMIN_WRITE_REQUESTS_PER_MINUTE=30
ADMIN_WRITE_AGGREGATE_REQUESTS_PER_MINUTE=120
PREVIEW_REQUESTS_PER_MINUTE=30
PREVIEW_AGGREGATE_REQUESTS_PER_MINUTE=300
RECOMMEND_REQUESTS_PER_MINUTE=6
RECOMMEND_AGGREGATE_REQUESTS_PER_MINUTE=30
# Automatic EQ has its own budget so song skipping cannot rate-limit /recommend.
GENRE_REQUESTS_PER_MINUTE=6
GENRE_AGGREGATE_REQUESTS_PER_MINUTE=30
YOUTUBE_EXPORT_REQUESTS_PER_MINUTE=6
YOUTUBE_EXPORT_AGGREGATE_REQUESTS_PER_MINUTE=30
AUTHENTICATED_USER_BUCKET_LIMIT=1000
AUTHENTICATED_USER_BUCKET_TTL_SECONDS=600
YOUTUBE_SEARCH_DAILY_BUDGET=80
YOUTUBE_MATCH_THRESHOLD=0.85
YOUTUBE_SEARCH_MAX_RESULTS=5
YOUTUBE_SEARCH_CONCURRENCY=3

# Backend timeouts (seconds)
HTTP_TIMEOUT_SECONDS=6

# Private CLAP + SVM service. Cloud Run uses the backend service identity.
# Disable IAM only for a local HTTP inference container, never a remote service.
CLAP_INFERENCE_URL=
# Set the untagged service origin when CLAP_INFERENCE_URL targets a revision tag.
CLAP_INFERENCE_AUDIENCE=
CLAP_INFERENCE_USE_IAM=true
CLAP_INFERENCE_TIMEOUT_SECONDS=90

# Keep authentication enabled by default. Set this to true only in a local .env
# when testing browser clients without a team token. Never enable it publicly.
ALLOW_UNAUTHENTICATED_RECOMMEND=false
CORS_ALLOWED_ORIGINS=chrome-extension://hfcclomfoickmehgmdgjdjmiiekaciam

# Docker Compose host port
BACKEND_PORT=8000
