{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "name": "Side-B Recommendation Client",
  "version": "0.1.0",
  "description": "Side-B 백엔드 추천 응답을 확인하는 개발용 익스텐션",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "https://side-b-backend-7hmhv6htsa-du.a.run.app/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "1073342688292-vrnnhbs5vhi6llpbhpd4174pedcsp7ld.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.force-ssl"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Side-B",
    "default_popup": "popup.html"
  }
}
