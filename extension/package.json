{
  "name": "side-b-chrome-extension",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild scripts/authWorker.entry.js --bundle --format=iife --global-name=SideBAuthBundle --platform=browser --target=chrome116 --outfile=dist/authWorker.js",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.cjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config=playwright.config.cjs",
    "test:e2e:recommend": "playwright test --config=playwright.config.cjs e2e/recommend.e2e.cjs",
    "test:e2e:export": "playwright test --config=playwright.config.cjs e2e/youtube-export.e2e.cjs",
    "test:e2e:deployed": "playwright test --config=playwright.live.config.cjs",
    "test:e2e:headed": "playwright test --config=playwright.config.cjs --headed",
    "test:e2e:persistence": "playwright test --config=playwright.config.cjs e2e/persistence.e2e.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "firebase": "12.19.0"
  }
}
